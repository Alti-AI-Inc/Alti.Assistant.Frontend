# ════════════════════════════════════════════════════════════════════════════════
#  APHURA FRONTEND — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ════════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.production on your deployment server:
# cp .env.production.example .env.production

# ── API & Backend URLs ────────────────────────────────────────────────────────
# Public URL where the browser sends API requests (e.g. https://api.aphura.ai/api/v1)
NEXT_PUBLIC_API_URL=https://api.aphura.ai/api/v1
API_URL=https://api.aphura.ai/api/v1

# ── NextAuth (Authentication) ────────────────────────────────────────────────
# Production root URL of the web frontend
NEXTAUTH_URL=https://aphura.ai
# Secret key for encrypting NextAuth session JWTs (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_32_byte_random_nextauth_secret_here

# ── Social OAuth Providers (Optional / As Needed) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── Stripe Public Key (Client-side checkout) ─────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here
