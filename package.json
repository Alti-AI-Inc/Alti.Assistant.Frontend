{
  "name": "aphura-frontend",
  "version": "3.0.46",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "ngrok": "ngrok http 3000",
    "dev:secure": "concurrently \"pnpm dev\" \"pnpm run ngrok\"",
    "dev:mkcert": "concurrently \"pnpm dev\" \"node ./scripts/dev-https-proxy.js --cert ./certs/localhost.pem --key ./certs/localhost-key.pem --listen 3443\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
